[Unit]
Description=Codex Worker
Documentation=https://github.com/arizzi74/Codex-Telegram-Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
Environment=HOME=%h
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/codex-worker --config %h/.config/codex-worker/config.json run
Restart=on-failure
RestartSec=3s
TimeoutStopSec=20s
NoNewPrivileges=no
PrivateTmp=yes
ProtectSystem=no
UMask=0077

[Install]
WantedBy=default.target
